{
  "name": "sparkwright",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "dev": "npm run setup:local && concurrently -k -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "scoring:eval": "tsx scripts/scoring-eval.ts",
    "owner:bootstrap": "tsx scripts/bootstrap-owner.ts",
    "build": "vite build",
    "build:community": "vite build --mode community",
    "start": "npm run setup:local && npm run build && tsx server/index.ts",
    "account:init": "npm run setup:local && tsx scripts/init-account.ts",
    "serve": "tsx server/index.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.3.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.4.0",
    "fastify": "^5.6.0",
    "nodemailer": "10.0.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "three": "0.186.1",
    "undici": "7.30.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
