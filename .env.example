# Personal client shows community login and an offline workspace option.
PORT=5318
WEB_PORT=5310
SPARKWRIGHT_LEADERBOARD_ENABLED=true
SPARKWRIGHT_AI_WRITES_ENABLED=true
VITE_GITHUB_URL=https://github.com/letsgo-6/SparkWright
COMMUNITY_URL=https://community.sparkwright.asia

# Optional shared AI service. Individual users can configure their own in Settings.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Community registration uses a separate cloud account, without SMTP or email codes.
# COMMUNITY_URL requires HTTPS, except loopback HTTP in development.
# Local workspace data and Keys are never uploaded automatically.
