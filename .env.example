# Copy to .env, then run npm run setup:local to generate AUTH_SECRET.
PORT=5318
WEB_PORT=5310
SPARKWRIGHT_LEADERBOARD_ENABLED=true
SPARKWRIGHT_AI_WRITES_ENABLED=true
VITE_GITHUB_URL=

# Optional shared AI service. Individual users can configure their own in Settings.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Optional email verification for multi-user registration. Do not share real values.
# APP_ORIGIN=https://your-domain.example
# NODE_ENV=production
# AUTH_COOKIE_SECURE=true
# EMAIL_SMTP_HOST=smtp.your-provider.example
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_SECURE=true
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASS=
# EMAIL_FROM=
# EMAIL_VERIFICATION_SECRET=
